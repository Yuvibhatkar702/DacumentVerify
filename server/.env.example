# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/document_verification

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Document Auto-Delete (in hours)
DOCUMENT_RETENTION_HOURS=24

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Aadhaar Sandbox Mode Configuration
# Set true for mock OTP flow, false for real Sandbox API integration.
AADHAAR_TEST_MODE=false
SANDBOX_BASE_URL=https://api.sandbox.co.in
SANDBOX_API_KEY=your_key_here
SANDBOX_API_SECRET=your_secret_here

# Optional crypto verification cert/key references
UIDAI_PUBLIC_CERT_PATH=
UIDAI_PUBLIC_KEY_PEM=
